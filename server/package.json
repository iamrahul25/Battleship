{
  "name": "battleship-server",
  "version": "1.0.0",
  "private": true,
  "description": "Battleship backend: Colyseus rooms, matchmaking, authoritative game state, and the shared engine/protocol.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --sourcemap --outfile=dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test",
    "format": "prettier --write .",
    "bot-sim": "tsx scripts/bot-sim.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.19",
    "@colyseus/monitor": "^0.18.6",
    "@colyseus/schema": "^5.0.40",
    "@colyseus/ws-transport": "^0.18.4",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/testing": "^0.18.6",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
