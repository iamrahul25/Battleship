{
  "name": "battleship-app",
  "version": "1.0.2",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "build:web": "expo export --platform web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "generate-assets": "python scripts/generate_assets.py",
    "release-apk": "node scripts/build-apk.js release",
    "preflight-apk": "node scripts/build-apk.js preflight release",
    "release-aab": "node scripts/build-apk.js aab",
    "preflight-aab": "node scripts/build-apk.js preflight aab",
    "postinstall": "node scripts/copy-canvaskit.js"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^@babel/runtime/(.*)$": "<rootDir>/node_modules/@babel/runtime/$1",
      "^@shared/(.*)$": "<rootDir>/../server/src/shared/$1",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^zod$": "<rootDir>/node_modules/zod"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@colyseus/.*|zustand)"
    ],
    "setupFiles": [
      "<rootDir>/src/test/setup.ts"
    ]
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@expo-google-fonts/black-ops-one": "^0.4.1",
    "@expo-google-fonts/rajdhani": "^0.4.1",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.13",
    "expo-audio": "~58.0.9",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.22",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.11",
    "typescript": "~6.0.3"
  }
}
